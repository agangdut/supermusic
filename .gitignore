# Everything here is made on your machine when you install or run SuperMusic.
# None of it is needed after a fresh `git clone`.

# --- Secrets and local settings --------------------------------------------
.env
.env.*
!.env.example
docker-compose.override.yml
*.pem
*.key
*.crt

# --- Python -----------------------------------------------------------------
.venv*/
venv/
env/
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
coverage/
htmlcov/
.ipynb_checkpoints/
*.log

# --- Node / frontend --------------------------------------------------------
node_modules/
.next/
out/
.turbo/
.vercel/
.netlify/
frontend/.env.local
frontend/tmp_uploads/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# package-lock.json is committed so Docker builds can use npm ci
yarn.lock
pnpm-lock.yaml

# --- Runtime data -----------------------------------------------------------
# Uploads, results, caches, benchmark datasets and model weights all live in
# data/ (see data/README.md) and download or regenerate on first use.
data/*
!data/README.md
backend/data/
/static/
# Accounts, votes and song facts live in one SQLite file (data/supermusic.db).
# Its journal files hold the same user data, so they're ignored too.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sql
*.dump

# --- User data ---------------------------------------------------------------
# Anything people upload or that identifies them stays out of git, wherever it
# lands. The code for accounts is fine to publish; their data is not.
uploads/
tmp_uploads/
shared_maps/
artifacts/
logs/
backups/
caddy_data/
caddy_config/
*.zip
# Spotify / Apple Music / YouTube exports (made-up copies for tests are allowed)
my_spotify_data/
Spotify Account Data/
Spotify Extended Streaming History/
StreamingHistory*.json
Streaming_History*.json
YourLibrary.json
Playlist*.json
Userdata.json
Identifiers.json
Payments.json
Inferences.json
Apple Music - *.csv
watch-history.json
search-history.json
!backend/tests/fixtures/**

# Audio, MIDI and model files never belong in git
*.mp3
*.wav
*.flac
*.m4a
*.ogg
*.opus
*.aac
*.mid
*.midi
*.pth
*.pt
*.ckpt
*.onnx
*.safetensors
*.bin

# Papers and office files (redistribution rights unclear)
*.pdf
*.docx
*.pptx

# --- Editors and operating systems ------------------------------------------
.vscode/
.idea/
*.iml
*.swp
*.tmp
*.bak
.DS_Store
Thumbs.db
desktop.ini
