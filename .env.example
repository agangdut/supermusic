# Copy to .env and fill in. docker compose reads this file automatically.

# Signs login tokens. Use a long random string in any shared or deployed setup.
JWT_SECRET_KEY=change-me-in-production

# Sites allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional: YouTube Data API key for extra details during CSV enrichment.
YOUTUBE_API_KEY=

# Hugging Face API token
HF_TOKEN=

# Optional: Last.fm API key (free, https://www.last.fm/api/account/create).
# Makes Music Map genres more accurate; without it MusicBrainz is used.
LASTFM_API_KEY=