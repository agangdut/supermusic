# Copy to .env and fill in. docker compose reads this file automatically.

# Signs login tokens. Use a long random string in any shared or deployed setup.
JWT_SECRET_KEY=change-me-in-production

# Sites allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Optional: YouTube Data API key for extra details during CSV enrichment.
YOUTUBE_API_KEY=

# Hugging Face API token
HF_TOKEN=

# Optional: Last.fm API key (free, https://www.last.fm/api/account/create).
# Makes Music Map genres more accurate; without it MusicBrainz is used.
LASTFM_API_KEY=

# Optional: Client ID of your own Spotify app, for Map Radio's "Save to Spotify" button.
# Create one at https://developer.spotify.com/dashboard, add the redirect URI
# http://127.0.0.1:3000/spotify-callback, and open SuperMusic at http://127.0.0.1:3000
# (Spotify doesn't accept "localhost"). In development mode only you and up to 5 people
# you add under User Management can use it. Rebuild after changing: docker compose build frontend
SPOTIFY_CLIENT_ID=
