# HTTPS for the public site. Caddy fetches and renews the certificate itself;
# SITE_DOMAIN must already point at this server (an A record) when it starts.

# HTTP/1.1 and HTTP/2 only, no HTTP/3 (QUIC over UDP). Inside Docker, QUIC gets small
# network buffers, and the server firewall only lets TCP in, so big downloads (the
# Atlas, stem files) could stall in some browsers while small pages still loaded.
{
	servers {
		protocols h1 h2
	}
}
{$SITE_DOMAIN} {
	encode zstd gzip

	# Library exports can be large; single songs are capped lower by the backend
	request_body {
		max_size 300MB
	}

	# The API, on the same address as the site: /api/map/build -> backend /map/build
	handle_path /api/* {
		reverse_proxy backend:8000 {
			# Music Map builds of big libraries can take a minute or two
			transport http {
				read_timeout 5m
				write_timeout 5m
			}
		}
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# REDIRECT_DOMAIN (www.<domain> unless set) sends visitors to the main address
{$REDIRECT_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
