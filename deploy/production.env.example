# Settings for the public site. Copy to .env next to docker-compose.prod.yml:
#   cp deploy/production.env.example .env
# Never commit the real .env (it's in .gitignore).

# Your domain, already pointing at this server (DNS A record). No https://, no slash.
SITE_DOMAIN=supermusic.example.com

# An address people can write to about privacy, copyright complaints or problems.
# It's shown on the Privacy and Terms pages.
CONTACT_EMAIL=

# Signs login tokens. Make one with:  openssl rand -hex 32
# Changing it later signs everybody out.
JWT_SECRET_KEY=

# Usernames that can open the admin page (/admin): reports and visitor stats.
# Comma separated. Sign up on the site first, then put your username here and
# restart:  docker compose -f docker-compose.prod.yml up -d backend
SM_ADMINS=

# Email for password reset links, through any SMTP service. Resend's free plan:
# verify your domain at resend.com, then SMTP_HOST=smtp.resend.com, SMTP_USER=resend,
# SMTP_PASSWORD=<your Resend API key>. Without SMTP_HOST, "Forgot your password?"
# tells people to write to CONTACT_EMAIL instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SuperMusic <hello@supermusic.example.com>

# 1 = only signed-in people can run stems / MIDI jobs (recommended at launch)
SM_REQUIRE_LOGIN_FOR_JOBS=1

# How many heavy jobs (stems, MIDI, piano covers) run at once. 1 per ~4 CPU cores
# and ~6 GB of memory is a safe start. Everyone else waits in line.
SM_HEAVY_WORKERS=1
# Per person: jobs waiting or running at once, and jobs per hour
SM_MAX_ACTIVE_JOBS=3
SM_JOBS_PER_HOUR=20

# Upload limits
SM_MAX_UPLOAD_MB=100
SM_MAX_SONG_MINUTES=15

# Uploaded songs and results are deleted after this many days (shared maps stay)
SM_KEEP_DAYS=7

# Downloading audio from YouTube links. Leave at 0 on a public site: it's against
# YouTube's terms, and the copyright risk is yours.
SM_ENABLE_DOWNLOADS=0

# Memory cap for the backend container
BACKEND_MEMORY=8g

# Optional services
LASTFM_API_KEY=
YOUTUBE_API_KEY=
# Needed only with --profile engines (MuScriptor's weights are gated on Hugging Face)
HF_TOKEN=
# Your Spotify app's Client ID. Add https://<SITE_DOMAIN>/spotify-callback as a
# redirect URI in the Spotify dashboard. Rebuild the frontend after changing it.
SPOTIFY_CLIENT_ID=
